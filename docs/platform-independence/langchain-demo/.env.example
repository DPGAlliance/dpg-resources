# Model provider. Default is self-hosted Ollama from compose.yaml.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
LLM_BASE_URL=http://ollama:11434

# Tracing: none | local (JSONL in the traces volume) | langsmith (hosted, opt-in).
# LANGSMITH_TRACING is intentionally not used: TRACING is the only switch.
TRACING=local
# LANGSMITH_API_KEY=lsv2_...      # required only when TRACING=langsmith
